# Copy this file to .env.local (which git ignores) and fill it in from the Supabase dashboard:
# Project Settings > API. Use the dev project locally. The public (anon) key is safe to put in
# the app; the service-role key must never appear here or anywhere in the app or the repo.
#
# For EAS builds these come from EAS environment variables instead, one set per environment
# (development, preview, production). `eas env:pull --environment development` writes them here.
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Google sign-in, from Google Cloud Console > APIs & Services > Credentials: the iOS client id
# (made for the bundle id com.malachitopp.hustle) and the web client id. Both are public. Both go
# into Supabase's Google provider too. Leave them out and the build has no Google sign-in. The
# iOS one also shapes the app's native config, so a development build is needed after changing it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-def.apps.googleusercontent.com
